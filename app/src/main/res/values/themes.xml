<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TripBoxie" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.TripBoxie" parent="Base.Theme.TripBoxie" />

    <style name="CustomDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/light_blue</item>
        <item name="dayStyle">@style/CustomDayStyle</item>
        <item name="yearStyle">@style/CustomYearStyle</item>
    </style>

    <style name="CustomDayStyle" parent="Widget.Material3.MaterialCalendar.Day">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gensenrounded_l</item>
    </style>

    <style name="CustomYearStyle" parent="Widget.Material3.MaterialCalendar.Year">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gensenrounded_r</item>
    </style>

    <style name="CustomTimePickerTheme" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="materialTimePickerStyle">@style/CustomMaterialTimePickerStyle</item>
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/light_blue</item>
    </style>

    <style name="CustomMaterialTimePickerStyle" parent="Widget.MaterialComponents.TimePicker">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gensenrounded_l</item>
    </style>

</resources>